<Window x:Class="ClaudePet.TalkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pet="clr-namespace:ClaudePet"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False"
        Deactivated="OnDeactivated">
    <!-- Terminal style, see Theme.cs. -->
    <Border Background="{x:Static pet:Theme.Panel}" BorderBrush="{x:Static pet:Theme.Accent}" BorderThickness="1"
            CornerRadius="4" Padding="10,7" Margin="4" MaxWidth="380">
        <StackPanel>
            <TextBlock x:Name="Reply" TextWrapping="Wrap" FontSize="12.5"
                       FontFamily="{x:Static pet:Theme.Mono}" Foreground="{x:Static pet:Theme.Text}" />
            <DockPanel x:Name="InputRow" Margin="0,5,0,0">
                <TextBlock Text="❯" DockPanel.Dock="Left" Margin="0,0,7,0" VerticalAlignment="Center"
                           FontFamily="{x:Static pet:Theme.Mono}" FontSize="13" Foreground="{x:Static pet:Theme.Accent}" />
                <TextBox x:Name="Input" Width="300" FontSize="13" FontFamily="{x:Static pet:Theme.Mono}"
                         Background="Transparent" Foreground="{x:Static pet:Theme.Text}" CaretBrush="{x:Static pet:Theme.Accent}"
                         BorderThickness="0" Padding="0,1" KeyDown="OnKeyDown" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
